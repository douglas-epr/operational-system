{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "move37-operational-system",
  // worker-entry.mjs wraps the generated .open-next/worker.js so the Worker can
  // also answer Cron Triggers; OpenNext only emits a `fetch` handler.
  "main": "worker-entry.mjs",

  // 2025-03-01 or later is required by @opennextjs/cloudflare.
  "compatibility_date": "2026-09-01",

  // nodejs_compat is mandatory for this app, not optional:
  //   - src/lib/auth/secretCompare.ts        -> node:crypto timingSafeEqual
  //   - src/app/api/webhooks/calcom/route.ts -> node:crypto createHmac
  //   - src/app/api/webhooks/tally/route.ts  -> node:crypto createHmac
  //   - src/lib/marketing/outreach.ts        -> node:crypto createHmac
  // global_fetch_strictly_public makes fetch() to our own hostname leave the
  // Worker and come back through the edge, which is what Next expects when a
  // server component fetches an absolute URL on this origin.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Cron Triggers, replacing the crons block Vercel used. Cloudflare invokes the
  // Worker's scheduled() handler rather than fetching a path, so worker-entry.mjs
  // maps each expression below onto its /api/mkt/cron/* route and signs the call
  // with CRON_SECRET. Keep these in sync with CRON_ROUTES in that file.
  // Hourly is safe here: Cloudflare Cron Triggers have no frequency floor,
  // unlike the Vercel Hobby plan which capped them at once per day and failed
  // the deployment outright for anything more frequent.
  "triggers": {
    "crons": ["0 * * * *", "15 * * * *", "30 * * * *"]
  }
}
