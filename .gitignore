# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# MCP config (contains API tokens — never commit)
.mcp.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (never commit — contain live secrets)
.env
.env.local
.env*.local
.env.development.local
.env.test.local
.env.production.local
.env.vercel-check

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local dumps (contain live production data/schema — never commit)
supabase/prod-data.sql
supabase/prod-full.sql

# supabase CLI temp files (contain connection strings — never commit)
supabase/.temp/


# Playwright MCP test artifacts
.playwright-mcp/

# Local attachments folder (screenshots, files — not for source control)
Attachments/

# logs & local runtime artifacts
*.log
archive/legacy-logs/
.claude/settings.local.json
.claude/scheduled_tasks.lock
supabase/snippets/
