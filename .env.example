# ─────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─────────────────────────────────────────────────────────────
# Brevo (Transactional & Bulk Email)
# ─────────────────────────────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=your-sender@yourdomain.com
BREVO_FROM_NAME=Move37

# ─────────────────────────────────────────────────────────────
# OpenRouter — REQUIRED. All text/JSON AI generation runs through
# this single platform key; users do not supply their own.
# ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=your-openrouter-api-key

# ─────────────────────────────────────────────────────────────
# OpenAI — image generation only (gpt-image-1)
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key

# ─────────────────────────────────────────────────────────────
# Gemini — image generation only
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ─────────────────────────────────────────────────────────────
# Brevo transactional email templates (magic link / password reset)
# ─────────────────────────────────────────────────────────────
BREVO_TEMPLATE_MAGIC_LINK=your-brevo-magic-link-template-id
BREVO_TEMPLATE_PASSWORD_RESET=your-brevo-password-reset-template-id

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────
# Marketing Validation Engine (docs/marketing/README.md)
# ─────────────────────────────────────────────────────────────
# Secures the Vercel Cron outreach worker. Vercel sends this as
# `Authorization: Bearer <CRON_SECRET>`. Generate a long random string.
CRON_SECRET=your-long-random-cron-secret

# Signs one-click unsubscribe links (GDPR/PECR). Dedicated purpose-built
# secret — never falls back to SUPABASE_SERVICE_ROLE_KEY. Falls back to
# CRON_SECRET only if unset. Generate a long random string.
UNSUBSCRIBE_SIGNING_SECRET=your-long-random-unsubscribe-signing-secret

# Configure Brevo's webhook UI to send transactional events to
# /api/webhooks/brevo?token=<this value> (query token, matching the
# Cal.com/Tally webhook pattern) — or as an `X-Brevo-Token` header if the
# Brevo plan in use only supports custom headers.
BREVO_WEBHOOK_SECRET=your-long-random-brevo-webhook-secret

# Cal.com booking webhook (BOOKING_CREATED → meeting_booked signal + interview
# stub). Configure in Cal.com as the webhook's signing secret.
CALCOM_WEBHOOK_SECRET=your-calcom-webhook-secret

# Tally.so form-response webhook (survey answers → mkt_signal). Configure in
# Tally as the webhook's signing secret. If unset, verification is skipped
# in development only (fails closed in production).
TALLY_WEBHOOK_SECRET=your-tally-webhook-secret

# Phase 2 — sourcing:
APIFY_TOKEN=your-apify-token
# Phase 3 — landing page image search (free at pexels.com/api):
PEXELS_API_KEY=your-pexels-api-key
# Phase 4 — social posting via Postiz (replaces Ayrshare; cheaper, open-source):
POSTIZ_API_KEY=your-postiz-api-key
POSTIZ_API_URL=https://api.postiz.com/public/v1
BUFFER_API_KEY=your-buffer-api-key
BUFFER_ORG_ID=your-buffer-org-id
