# ─────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─────────────────────────────────────────────────────────────
# Brevo (Transactional & Bulk Email)
# Source: docs/reference_docs/api-connectors.md — Brevo connector
# ─────────────────────────────────────────────────────────────
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=your-sender@yourdomain.com
BREVO_FROM_NAME=Move37

# ─────────────────────────────────────────────────────────────
# OpenAI
# Source: docs/reference_docs/api-connectors.md — OpenAI connector (GPT-5 / Responses API)
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key

# ─────────────────────────────────────────────────────────────
# Gemini (Google Generative Language)
# Source: docs/reference_docs/api-connectors.md — Gemini connector (gemini-2.5-flash)
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Marketing Validation Engine (docs/marketing/README.md)
# ─────────────────────────────────────────────────────────────
# Secures the Vercel Cron outreach worker. Vercel sends this as
# `Authorization: Bearer <CRON_SECRET>`. Generate a long random string.
CRON_SECRET=your-long-random-cron-secret

# Phase 2 — sourcing:
APOLLO_API_KEY=your-apollo-api-key
APIFY_TOKEN=your-apify-token
# Phase 4 — social posting via Postiz (replaces Ayrshare; cheaper, open-source):
POSTIZ_API_KEY=your-postiz-api-key
POSTIZ_CLIENT_ID=your-postiz-client-id
POSTIZ_API_URL=https://api.postiz.com/public/v1
# Pre-order capture (deferred):
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
